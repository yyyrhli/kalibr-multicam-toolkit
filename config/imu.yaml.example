# Kalibr IMU 噪声（单位见官方 wiki）。
# 优先用手册或长静置 Allan；短静置只能估白噪声，random_walk 用 MEMS 经验值。
#
# 可在 prepare 时根据本次 bag 开头静置段自动改写 noise_density。

accelerometer_noise_density: 0.0015
accelerometer_random_walk: 0.0002
gyroscope_noise_density: 9.6e-05
gyroscope_random_walk: 4.0e-06
update_rate: 200.0
rostopic: /imu0
